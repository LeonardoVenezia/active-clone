  {
   "id": "create-sheet",
   "data": {
    "type": "action",
    "label": "Crear Planilla Stock Bajo",
    "config": {
     "tool": "GOOGLESHEETS_CREATE_GOOGLE_SHEET1",
     "toolkit": "googlesheets",
     "arguments": "{\"title\": \"Stock bajo\"}",
     "actionType": "composio/run-tool"
    },
    "status": "idle"
   },
   "type": "action",
   "position": {
    "x": 830,
    "y": 335
   }
  },
  {
   "id": "loop-tiendanube",
   "data": {
    "type": "action",
    "label": "Procesar Stock Tiendanube",
    "config": {
     "steps": [
      {
       "id": "check-tn",
       "config": {
        "condition": "{{@item:Item.totalStock}} < 5"
       },
       "actionType": "Condition"
      },
      {
       "id": "append-tn",
       "config": {
        "tool": "GOOGLESHEETS_SPREADSHEETS_VALUES_APPEND",
        "toolkit": "googlesheets",
        "arguments": "{\"spreadsheetId\": \"{{@create-sheet:Crear Planilla Stock Bajo.data.spreadsheetId}}\", \"range\": \"Sheet1!A:D\", \"valueInputOption\": \"USER_ENTERED\", \"values\": [[\"{{@item:Item.name}}\", \"{{@item:Item.id}}\", \"{{@item:Item.totalStock}}\", \"Tiendanube\"]]}"
       },
       "actionType": "composio/run-tool"
      }
     ],
     "source": "{{@list-tiendanube:Obtener Productos Tiendanube.products}}",
     "maxItems": 50,
     "actionType": "Loop"
    },
    "status": "idle"
   },
   "type": "action",
   "position": {
    "x": 1200,
    "y": 410
   }
  },
  {
   "id": "loop-mercadolibre",
   "data": {
    "type": "action",
    "label": "Procesar Stock Mercado Libre",
    "config": {
     "steps": [
      {
       "id": "check-ml",
       "config": {
        "condition": "{{@item:Item.availableQuantity}} < 5"
       },
       "actionType": "Condition"
      },
      {
       "id": "append-ml",
       "config": {
        "tool": "GOOGLESHEETS_SPREADSHEETS_VALUES_APPEND",
        "toolkit": "googlesheets",
        "arguments": "{\"spreadsheetId\": \"{{@create-sheet:Crear Planilla Stock Bajo.data.spreadsheetId}}\", \"range\": \"Sheet1!A:D\", \"valueInputOption\": \"USER_ENTERED\", \"values\": [[\"{{@item:Item.title}}\", \"{{@item:Item.id}}\", \"{{@item:Item.availableQuantity}}\", \"Mercado Libre\"]]}"
       },
       "actionType": "composio/run-tool"
      }
     ],
     "source": "{{@list-mercadolibre:Obtener Productos Mercado Libre.items}}",
     "maxItems": 50,
     "actionType": "Loop"
    },
    "status": "idle"
   },
   "type": "action",
