    {
      "id": "reconcile-formula",
      "data": {
        "type": "action",
        "label": "Comparar Cobros y Órdenes",
        "config": {
          "input": "{\"pagos\": {{@stripe-payments:Cobros Stripe Ayer.payments}}, \"ordenes\": {{@tiendanube-orders:Órdenes Tiendanube Ayer.orders}}}",
          "actionType": "Fórmula",
          "expression": "{\"soloEnA\": $filter(pagos, function($x) { $not($number($x.amount) in $map(ordenes, function($y){ $number($y.total) })) }), \"ordenesSinCobro\": $filter(ordenes, function($y) { $not($number($y.total) in $map(pagos, function($x){ $number($x.amount) })) })}"
        },
        "status": "idle"
      },
      "type": "action",
      "position": {
        "x": 830,
        "y": 260
      }
    },
    {
      "id": "loop-cobros",
      "data": {
        "type": "action",
        "label": "Procesar Cobros sin Orden",
        "config": {
          "steps": [
            {
              "id": "guardar-cobro",
              "config": {
                "tool": "GOOGLESHEETS_BATCH_UPDATE",
                "toolkit": "googlesheets",
                "arguments": "{\"spreadsheet_id\": \"1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms\", \"sheet_name\": \"Diferencias\", \"values\": [[ \"Cobro sin orden\", \"{{@item:Item.id}}\", \"{{@item:Item.amount}}\" ]], \"value_input_option\": \"USER_ENTERED\"}"
              },
              "actionType": "composio/run-tool"
            }
          ],
          "source": "{{@reconcile-formula:Comparar Cobros y Órdenes.result.soloEnA}}",
          "maxItems": 50,
          "actionType": "Loop"
        },
        "status": "idle"
      },
