{
  "name": "Control de Stock Diario (Tiendanube + Mercado Libre)",
  "nodes": [
    {
      "id": "trigger-diario",
      "type": "trigger",
      "position": {
        "x": 90,
        "y": 185
      },
      "data": {
        "label": "Todos los días 9 AM",
        "description": "Dispara el control de stock cada día a las 9:00",
        "type": "trigger",
        "config": {
          "triggerType": "Schedule",
          "scheduleCron": "0 9 * * *"
        },
        "status": "idle"
      }
    },
    {
      "id": "listar-tiendanube",
      "type": "action",
      "position": {
        "x": 460,
        "y": 260
      },
      "data": {
        "label": "Listar Productos Tiendanube",
        "description": "Obtiene los productos y su stock desde Tiendanube",
        "type": "action",
        "config": {
          "actionType": "tiendanube/list-products",
          "query": "",
          "limit": "200"
        },
        "status": "idle"
      }
    },
    {
      "id": "listar-mercadolibre",
      "type": "action",
      "position": {
        "x": 460,
        "y": 110
      },
      "data": {
        "label": "Listar Publicaciones Mercado Libre",
        "description": "Obtiene las publicaciones activas y su stock disponible en Mercado Libre",
        "type": "action",
        "config": {
          "actionType": "mercadolibre/list-items",
          "query": "",
          "status": "active",
          "limit": "100"
        },
        "status": "idle"
      }
    },
    {
      "id": "hay-mas-de-3",
      "type": "action",
      "position": {
        "x": 1570,
        "y": 185
      },
      "data": {
        "label": "¿Más de 3 en falta?",
        "description": "Verifica si hay más de 3 productos con stock bajo",
        "type": "action",
        "config": {
          "actionType": "Condition",
          "condition": "{{@total-en-falta:Total en Falta.result}} > 3"
        },
        "status": "idle"
      }
    },
    {
      "id": "avisar-compras",
      "type": "action",
      "position": {
        "x": 1940,
        "y": 185
      },
      "data": {
        "label": "Avisar a #compras - Slack",
        "description": "Notifica en Slack cuando hay más de 3 productos en falta",
        "type": "action",
        "config": {
          "actionType": "slack/send-message",
          "slackChannel": "#compras",
          "slackMessage": "Alerta de stock: {{@total-en-falta:Total en Falta.result}} productos quedaron con menos de 5 unidades ({{@loop-tiendanube:Anotar Stock Bajo Tiendanube.count}} de Tiendanube y {{@loop-mercadolibre:Anotar Stock Bajo Mercado Libre.count}} de Mercado Libre) y ya fueron registrados en la planilla."
        },
        "status": "idle"
      }
    },
    {
      "id": "loop-tiendanube",
      "type": "action",
      "position": {
        "x": 830,
        "y": 260
      },
      "data": {
        "label": "Anotar Stock Bajo Tiendanube",
        "description": "Recorre los productos de Tiendanube y anota en la planilla solo los que tienen stock menor a 5",
        "type": "action",
        "config": {
          "actionType": "Loop",
          "source": "{{@listar-tiendanube:Listar Productos Tiendanube.products}}",
          "maxItems": 200,
          "steps": [
            {
              "id": "stock-bajo-tn",
              "actionType": "Condition",
              "config": {
                "condition": "{{@item:Item.totalStock}} < 5"
              }
            },
            {
              "id": "anotar-tn",
              "actionType": "composio/run-tool",
              "config": {
                "toolkit": "googlesheets",
                "tool": "GOOGLESHEETS_SPREADSHEETS_VALUES_APPEND",
                "arguments": "{\"spreadsheetId\": \"TU_SPREADSHEET_ID\", \"range\": \"Stock!A:D\", \"valueInputOption\": \"USER_ENTERED\", \"values\": [[\"Tiendanube\", \"{{@item:Item.name}}\", \"{{@item:Item.id}}\", \"{{@item:Item.totalStock}}\"]]}"
              }
            }
          ]
        },
        "status": "idle"
      }
    },
    {
      "id": "loop-mercadolibre",
      "type": "action",
      "position": {
        "x": 830,
        "y": 110
      },
      "data": {
        "label": "Anotar Stock Bajo Mercado Libre",
        "description": "Recorre las publicaciones de Mercado Libre y anota en la planilla solo las que tienen stock menor a 5",
        "type": "action",
        "config": {
          "actionType": "Loop",
          "source": "{{@listar-mercadolibre:Listar Publicaciones Mercado Libre.items}}",
          "maxItems": 100,
          "steps": [
            {
              "id": "stock-bajo-ml",
              "actionType": "Condition",
              "config": {
                "condition": "{{@item:Item.availableQuantity}} < 5"
              }
            },
            {
              "id": "anotar-ml",
              "actionType": "composio/run-tool",
              "config": {
                "toolkit": "googlesheets",
                "tool": "GOOGLESHEETS_SPREADSHEETS_VALUES_APPEND",
                "arguments": "{\"spreadsheetId\": \"TU_SPREADSHEET_ID\", \"range\": \"Stock!A:D\", \"valueInputOption\": \"USER_ENTERED\", \"values\": [[\"Mercado Libre\", \"{{@item:Item.title}}\", \"{{@item:Item.id}}\", \"{{@item:Item.availableQuantity}}\"]]}"
              }
            }
          ]
        },
        "status": "idle"
      }
    },
    {
      "id": "total-en-falta",
      "type": "action",
      "position": {
        "x": 1200,
        "y": 185
      },
      "data": {
        "label": "Total en Falta",
        "description": "Suma los productos con stock bajo anotados en la planilla",
        "type": "action",
        "config": {
          "actionType": "Fórmula",
          "input": "{\"tiendanube\": {{@loop-tiendanube:Anotar Stock Bajo Tiendanube.count}}, \"mercadolibre\": {{@loop-mercadolibre:Anotar Stock Bajo Mercado Libre.count}}}",
          "expression": "tiendanube + mercadolibre"
        },
        "status": "idle"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "trigger-diario",
      "target": "listar-tiendanube",
      "type": "default"
    },
    {
      "id": "e2",
      "source": "trigger-diario",
      "target": "listar-mercadolibre",
      "type": "default"
    },
    {
      "id": "e7",
      "source": "hay-mas-de-3",
      "target": "avisar-compras",
      "type": "default"
    },
    {
      "id": "e-tn-loop",
      "source": "listar-tiendanube",
      "target": "loop-tiendanube",
      "type": "default"
    },
    {
      "id": "e-ml-loop",
      "source": "listar-mercadolibre",
      "target": "loop-mercadolibre",
      "type": "default"
    },
    {
      "id": "e-loop-tn-total",
      "source": "loop-tiendanube",
      "target": "total-en-falta",
      "type": "default"
    },
    {
      "id": "e-loop-ml-total",
      "source": "loop-mercadolibre",
      "target": "total-en-falta",
      "type": "default"
    },
    {
      "id": "e-total-cond",
      "source": "total-en-falta",
      "target": "hay-mas-de-3",
      "type": "default"
    }
  ]
}