    {
      "id": "reconcile-compare",
      "data": {
        "type": "action",
        "label": "Comparador de diferencias",
        "config": {
          "input": "{\"pagos\": {{@stripe-payments:Cobros Stripe.payments}}, \"ordenes\": {{@tiendanube-orders:Órdenes Tiendanube.orders}}}",
          "actionType": "Fórmula",
          "expression": "{\"soloEnA\": $filter(pagos, function($x) { $not($number($x.amount) in $map(ordenes, function($y){ $number($y.total) })) }), \"soloEnB\": $filter(ordenes, function($y) { $not($number($y.total) in $map(pagos, function($x){ $number($x.amount) })) })}"
        },
        "status": "idle"
      },
      "type": "action",
