              "config": {
                "toolkit": "googlesheets",
                "tool": "GOOGLESHEETS_SPREADSHEET_VALUES_APPEND",
                "arguments": "{\"spreadsheet_id\": \"PEGA_EL_ID_DE_LA_PLANILLA\", \"range\": \"Reconciliacion!A1\", \"values\": [[\"Cobro sin orden\", \"{{@item:Item.id}}\", \"{{@item:Item.amount}}\", \"{{@item:Item.currency}}\", \"{{@item:Item.status}}\", \"{{@item:Item.created}}\"]]}"
              }
