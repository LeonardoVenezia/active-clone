      },
      "data": {
        "label": "Cobros Stripe",
        "type": "action",
        "config": {
          "customerId": "",
          "limit": "100",
          "actionType": "stripe/list-payments"
        },
        "status": "idle"
      }
    },
    {
      "id": "ordenes-tiendanube",
      "type": "action",
      "position": {
        "x": 460,
        "y": 110
      },
      "data": {
        "label": "Ordenes Tiendanube",
        "type": "action",
        "config": {
          "query": "",
          "status": "any",
          "paymentStatus": "any",
          "shippingStatus": "any",
          "limit": 100,
          "actionType": "tiendanube/search-orders"
        },
        "status": "idle"
      }
    },
    {
      "id": "comparar",
      "type": "action",
      "position": {
        "x": 830,
        "y": 185
      },
      "data": {
        "label": "Comparar Diferencias",
        "type": "action",
        "config": {
          "input": "{\"cobros\": {{@cobros-stripe:Cobros Stripe.payments}}, \"ordenes\": {{@ordenes-tiendanube:Ordenes Tiendanube.orders}}}",
          "expression": "{\"cobrosSinOrden\": $filter(cobros, function($x) { $not($number($x.amount) in $map(ordenes, function($y){ $number($y.total) })) }), \"ordenesSinCobro\": $filter(ordenes, function($y) { $not($number($y.total) in $map(cobros, function($x){ $number($x.amount) })) })}",
          "actionType": "Fórmula"
        },
        "status": "idle"
      }
    },
    {
      "id": "resumen-gmail",
      "type": "action",
      "position": {
        "x": 2310,
        "y": 185
      },
      "data": {
        "label": "Resumen por Gmail",
        "type": "action",
        "config": {
          "toolkit": "gmail",
          "tool": "GMAIL_SEND_EMAIL",
          "arguments": "{\"recipient_email\": \"finanzas@tuempresa.com\", \"subject\": \"Reconciliacion diaria Stripe vs Tiendanube - diferencias detectadas\", \"body\": \"Hola equipo de finanzas,\\n\\nSe ejecuto la reconciliacion diaria en modo maqueta (sin movimientos reales).\\n\\n1) Cobros de Stripe sin orden asociada:\\n{{@comparar:Comparar Diferencias.result.cobrosSinOrden}}\\n\\n2) Ordenes de Tiendanube sin cobro:\\n{{@comparar:Comparar Diferencias.result.ordenesSinCobro}}\\n\\nEl detalle quedo registrado en la planilla de Google Sheets (hoja Reconciliacion).\\n\\nSaludos,\\nAutomatizacion de finanzas\"}",
          "actionType": "composio/run-tool"
        },
        "status": "idle"
      }
    },
    {
      "id": "preparar-planilla",
      "type": "action",
      "position": {
        "x": 1200,
        "y": 185
      },
      "data": {
        "label": "Preparar Planilla Sheets",
        "type": "action",
        "config": {
          "toolkit": "googlesheets",
          "tool": "GOOGLESHEETS_SPREADSHEET_VALUES_UPDATE",
          "arguments": "{\"spreadsheet_id\": \"PEGA_EL_ID_DE_LA_PLANILLA\", \"range\": \"Reconciliacion!A1:F3\", \"values\": [[\"Tipo de diferencia\", \"Referencia\", \"Monto\", \"Moneda\", \"Estado\", \"Fecha\"], [\"Cobros Stripe sin orden\", \"{{@comparar:Comparar Diferencias.result.cobrosSinOrden}}\", \"\", \"\", \"\", \"{{@cobros-stripe:Cobros Stripe.count}}\"], [\"Ordenes Tiendanube sin cobro\", \"{{@comparar:Comparar Diferencias.result.ordenesSinCobro}}\", \"\", \"\", \"\", \"{{@ordenes-tiendanube:Ordenes Tiendanube.count}}\"]]}",
          "actionType": "composio/run-tool"
        },
        "status": "idle"
      }
    },
    {
      "id": "extraer-cobros-sin-orden",
      "type": "action",
      "position": {
        "x": 1570,
        "y": 260
      },
      "data": {
        "label": "Extraer Cobros Sin Orden",
        "type": "action",
        "config": {
          "input": "{\"diferencias\": {{@comparar:Comparar Diferencias.result}}}",
