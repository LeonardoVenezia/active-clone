  {
   "id": "compare-data",
   "data": {
    "type": "action",
    "label": "Comparar Pagos y Órdenes",
    "config": {
     "input": "{\"stripe\": {{@stripe-payments:Cobros Stripe.payments}}, \"tiendanube\": {{@tiendanube-orders:Órdenes Tiendanube.orders}}}",
     "actionType": "Fórmula",
     "expression": "{\"cobrosSinOrden\": $filter(stripe, function($x) { $not($number($x.amount) in $map(tiendanube, function($y){ $number($y.total) })) }), \"ordenesSinCobro\": $filter(tiendanube, function($y) { $not($number($y.total) in $map(stripe, function($x){ $number($x.amount) })) })}"
    },
    "status": "idle",
    "description": "Detectar cobros sin orden u órdenes sin cobro"
