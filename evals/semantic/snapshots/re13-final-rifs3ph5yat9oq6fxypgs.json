      "id": "reconciliation-formula",
      "data": {
        "type": "action",
        "label": "Comparar Cobros y Órdenes",
        "config": {
          "input": "{\"pagos\": {{@stripe-payments:Cobros Stripe del Día Anterior.payments}}, \"ordenes\": {{@tiendanube-orders:Órdenes Tiendanube del Día Anterior.orders}}}",
          "actionType": "Fórmula",
          "expression": "{\"soloEnA\": $filter(pagos, function($x) { $not($number($x.amount) in $map(ordenes, function($y){ $number($y.total) })) }), \"soloEnB\": $filter(ordenes, function($y) { $not($number($y.total) in $map(pagos, function($x){ $number($x.amount) })) })}"
