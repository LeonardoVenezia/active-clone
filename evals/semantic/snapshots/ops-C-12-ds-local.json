{
  "name": "Control de Stock Diario (Maqueta)",
  "nodes": [
    {
      "id": "trigger-9am",
      "type": "trigger",
      "position": {
        "x": 90,
        "y": 185
      },
      "data": {
        "label": "Todos los Días 9:00",
        "description": "Disparo diario a las 9 de la mañana (modo maqueta, no ejecuta)",
        "type": "trigger",
        "config": {
          "triggerType": "Schedule",
          "scheduleCron": "0 9 * * *"
        },
        "status": "idle"
      }
    },
    {
      "id": "list-tn",
      "type": "action",
      "position": {
        "x": 460,
        "y": 260
      },
      "data": {
        "label": "Listar Productos Tiendanube",
        "description": "Obtiene los productos y su stock desde Tiendanube",
        "type": "action",
        "config": {
          "actionType": "tiendanube/list-products",
          "query": "",
          "limit": "200"
        },
        "status": "idle"
      }
    },
    {
      "id": "list-ml",
      "type": "action",
      "position": {
        "x": 460,
        "y": 110
      },
      "data": {
        "label": "Listar Items Mercado Libre",
        "description": "Obtiene las publicaciones y su stock desde Mercado Libre",
        "type": "action",
        "config": {
          "actionType": "mercadolibre/list-items",
          "query": "",
          "status": "active",
          "limit": "200"
        },
        "status": "idle"
      }
    },
    {
      "id": "stock-bajo",
      "type": "action",
      "position": {
        "x": 830,
        "y": 185
      },
      "data": {
        "label": "Productos con Stock Bajo",
        "description": "Une ambas listas y filtra los productos con stock menor a 5 unidades",
        "type": "action",
        "config": {
          "actionType": "Fórmula",
          "input": "{\"tn\": {{@list-tn:Listar Productos Tiendanube.products}}, \"ml\": {{@list-ml:Listar Items Mercado Libre.items}}}",
          "expression": "($b := $filter($append($map(tn, function($p){ {\"origen\": \"Tiendanube\", \"producto\": $p.name, \"stock\": $p.totalStock} }), $map(ml, function($i){ {\"origen\": \"Mercado Libre\", \"producto\": $i.title, \"stock\": $i.availableQuantity} })), function($x){ $number($x.stock) < 5 }); {\"bajoStock\": $b, \"cantidad\": $count($b)})"
        },
        "status": "idle"
      }
    },
    {
      "id": "loop-planilla",
      "type": "action",
      "position": {
        "x": 1200,
        "y": 185
      },
      "data": {
        "label": "Anotar en Google Sheets",
        "description": "Agrega una fila por cada producto con stock bajo en Google Sheets",
        "type": "action",
        "config": {
          "actionType": "Loop",
          "source": "{{@stock-bajo:Productos con Stock Bajo.result.bajoStock}}",
          "maxItems": 200,
          "steps": [
            {
              "id": "google-sheets-append-row",
              "actionType": "composio/run-tool",
              "config": {
                "toolkit": "googlesheets",
                "tool": "GOOGLESHEETS_SPREADSHEETS_VALUES_APPEND",
                "arguments": "{\"spreadsheet_id\": \"{{SPREADSHEET_ID}}\", \"range\": \"Stock!A1\", \"valueInputOption\": \"USER_ENTERED\", \"values\": [[\"{{@item:Item.origen}}\", \"{{@item:Item.producto}}\", \"{{@item:Item.stock}}\"]]}"
              }
            }
          ]
        },
        "status": "idle"
      }
    },
    {
      "id": "cond-mas-de-3",
      "type": "action",
      "position": {
        "x": 1570,
        "y": 185
      },
      "data": {
        "label": "Más de 3 Productos",
        "description": "Verifica si hay más de 3 productos con stock bajo",
        "type": "action",
        "config": {
          "actionType": "Condition",
          "condition": "{{@stock-bajo:Productos con Stock Bajo.result.cantidad}} > 3"
        },
        "status": "idle"
      }
    },
    {
      "id": "slack-compras",
      "type": "action",
      "position": {
        "x": 1940,
        "y": 185
      },
      "data": {
        "label": "Avisar Compras - Slack",
        "description": "Avisa al canal #compras que hay más de 3 productos con stock bajo",
        "type": "action",
        "config": {
          "actionType": "slack/send-message",
          "slackChannel": "#compras",
          "slackMessage": "Alerta de stock: {{@stock-bajo:Productos con Stock Bajo.result.cantidad}} productos quedaron con menos de 5 unidades (Tiendanube + Mercado Libre). Revisá la planilla de stock."
        },
        "status": "idle"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "trigger-9am",
      "target": "list-tn",
      "type": "default"
    },
    {
      "id": "e2",
      "source": "trigger-9am",
      "target": "list-ml",
      "type": "default"
    },
    {
      "id": "e3",
      "source": "list-tn",
      "target": "stock-bajo",
      "type": "default"
    },
    {
      "id": "e4",
      "source": "list-ml",
      "target": "stock-bajo",
      "type": "default"
    },
    {
      "id": "e5",
      "source": "stock-bajo",
      "target": "loop-planilla",
      "type": "default"
    },
    {
      "id": "e6",
      "source": "loop-planilla",
      "target": "cond-mas-de-3",
      "type": "default"
    },
    {
      "id": "e7",
      "source": "cond-mas-de-3",
      "target": "slack-compras",
      "type": "default"
    }
  ]
}