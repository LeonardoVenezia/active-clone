      }
    },
    {
      "id": "rango-ayer",
      "type": "action",
      "position": {
        "x": 460,
        "y": 260
      },
      "data": {
        "label": "Rango de ayer",
        "type": "action",
        "config": {
          "input": "{\"hoy\": 1}",
          "expression": "{\"desde\": $fromMillis($toMillis($now()) - 86400000 * hoy, \"[Y0001]-[M01]-[D01]T00:00:00-03:00\"), \"hasta\": $fromMillis($toMillis($now()), \"[Y0001]-[M01]-[D01]T23:59:59-03:00\")}",
          "actionType": "Fórmula"
        },
        "status": "idle"
      }
    },
    {
      "id": "cobros-stripe",
      "type": "action",
      "position": {
        "x": 830,
        "y": 110
      },
      "data": {
        "label": "Cobros Stripe ayer",
        "type": "action",
        "config": {
          "limit": "100",
          "actionType": "stripe/list-payments"
        },
        "status": "idle"
      }
    },
    {
      "id": "ordenes-tiendanube",
      "type": "action",
      "position": {
        "x": 830,
        "y": 260
      },
      "data": {
        "label": "Órdenes Tiendanube ayer",
        "type": "action",
        "config": {
          "status": "any",
          "paymentStatus": "any",
          "shippingStatus": "any",
          "createdAtMin": "{{@rango-ayer:Rango de ayer.result.desde}}",
          "limit": 100,
          "actionType": "tiendanube/search-orders"
        },
        "status": "idle"
      }
    },
    {
      "id": "comparar",
      "type": "action",
      "position": {
        "x": 1200,
        "y": 185
      },
      "data": {
        "label": "Comparar cobros vs órdenes",
        "type": "action",
        "config": {
          "input": "{\"cobros\": {{@cobros-stripe:Cobros Stripe ayer.payments}}, \"ordenes\": {{@ordenes-tiendanube:Órdenes Tiendanube ayer.orders}}}",
          "expression": "{\"cobrosSinOrden\": $filter(cobros, function($x) { $not($number($x.amount) in $map(ordenes, function($y){ $number($y.total) })) }), \"ordenesSinCobro\": $filter(ordenes, function($y) { $not($number($y.total) in $map(cobros, function($x){ $number($x.amount) })) })}",
          "actionType": "Fórmula"
        },
        "status": "idle"
      }
    },
    {
      "id": "sheet-cobros-sin-orden",
      "type": "action",
      "position": {
        "x": 1570,
        "y": 185
      },
      "data": {
        "label": "Anotar cobros sin orden",
        "type": "action",
        "config": {
          "toolkit": "googlesheets",
          "tool": "GOOGLESHEETS_APPEND_ROW",
          "arguments": "{\"spreadsheet_id\": \"1AbCdEfGhIjKlMnOpQrStUvWxYz_REEMPLAZAR\", \"sheet_name\": \"Reconciliacion\", \"values\": [[\"{{@comparar:Comparar cobros vs órdenes.result.cobrosSinOrden}}\", \"cobro_sin_orden\"]], \"value_input_option\": \"USER_ENTERED\"}",
          "actionType": "composio/run-tool"
        },
        "status": "idle"
      }
