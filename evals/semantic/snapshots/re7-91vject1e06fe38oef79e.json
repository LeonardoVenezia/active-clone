  {
   "id": "loop-tiendanube",
   "data": {
    "type": "action",
    "label": "Process Tiendanube Products",
    "config": {
     "steps": [
      {
       "id": "check-tn-stock",
       "config": {
        "condition": "{{@item:Item.totalStock}} < 5"
       },
       "actionType": "Condition"
      },
      {
       "id": "append-tn-sheet",
       "config": {
        "tool": "GOOGLESHEETS_SPREADSHEETS_VALUES_APPEND",
        "toolkit": "googlesheets",
        "arguments": "{\"spreadsheetId\": \"{{@create-sheet:Create Stock Diario Sheet.spreadsheet_id}}\", \"range\": \"A:D\", \"valueInputOption\": \"USER_ENTERED\", \"values\": [[\"{{@item:Item.id}}\", \"{{@item:Item.name}}\", \"{{@item:Item.totalStock}}\", \"Tiendanube\"]]}"
       },
       "actionType": "composio/run-tool"
      }
     ],
     "source": "{{@get-tiendanube-products:Get Tiendanube Products.products}}",
     "maxItems": 200,
     "actionType": "Loop"
    },
    "status": "idle"
   },
   "type": "action",
   "position": {
    "x": 830,
    "y": 258
   }
  },
  {
   "id": "loop-mercadolibre",
   "data": {
    "type": "action",
    "label": "Process Mercado Libre Items",
    "config": {
     "steps": [
      {
       "id": "check-ml-stock",
       "config": {
        "condition": "{{@item:Item.availableQuantity}} < 5"
       },
       "actionType": "Condition"
      },
      {
       "id": "append-ml-sheet",
       "config": {
        "tool": "GOOGLESHEETS_SPREADSHEETS_VALUES_APPEND",
        "toolkit": "googlesheets",
        "arguments": "{\"spreadsheetId\": \"{{@create-sheet:Create Stock Diario Sheet.spreadsheet_id}}\", \"range\": \"A:D\", \"valueInputOption\": \"USER_ENTERED\", \"values\": [[\"{{@item:Item.id}}\", \"{{@item:Item.title}}\", \"{{@item:Item.availableQuantity}}\", \"Mercado Libre\"]]}"
       },
       "actionType": "composio/run-tool"
      }
     ],
     "source": "{{@get-mercadolibre-items:Get Mercado Libre Items.items}}",
     "maxItems": 200,
     "actionType": "Loop"
    },
    "status": "idle"
   },
   "type": "action",
   "position": {
    "x": 1570,
    "y": 280
   }
  },
  {
   "id": "combine-filter",
   "data": {
    "type": "action",
    "label": "Combine & Filter Low Stock",
    "config": {
     "input": "{\"tn\": {{@loop-tiendanube:Process Tiendanube Products.items}}, \"ml\": {{@loop-mercadolibre:Process Mercado Libre Items.items}}",
     "actionType": "Fórmula",
     "expression": "$append(tn.steps.check_tn_stock ? [tn.item] : [], ml.steps.check_ml_stock ? [ml.item] : [])"
    },
    "status": "idle"
   },
   "type": "action",
