        "label": "Anotar en Google Sheets",
        "config": {
          "tool": "GOOGLESHEETS_BATCH_UPDATE",
          "toolkit": "googlesheets",
          "arguments": "{\"spreadsheet_id\": \"spreadsheet_id_placeholder\", \"sheet_name\": \"Diferencias\", \"values\": [[\"{{@compare-reconciliation:Procesador de Cobros.soloEnA}}\"]]}",
