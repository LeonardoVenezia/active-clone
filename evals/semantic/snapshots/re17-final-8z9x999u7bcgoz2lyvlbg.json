    {
      "id": "compare-lists",
      "data": {
        "type": "action",
        "label": "Comparar Listados",
        "config": {
          "steps": [
            {
              "id": "check-order",
              "config": {
                "condition": "{{@item:Item.amount}} > 0"
              },
              "actionType": "Condition"
            },
            {
              "id": "log-diff",
              "tool": "GOOGLESHEETS_BATCH_UPDATE",
              "toolkit": "googlesheets",
              "arguments": "{\"spreadsheet_id\": \"Reconciliación Diaria\", \"sheet_name\": \"Hoja 1\", \"values\": [[{{@item:Item.id}}, {{@item:Item.amount}}]]}",
              "actionType": "composio/run-tool"
            }
          ],
          "source": "{{@stripe-charges:Cobros de Stripe.payments}}",
          "maxItems": 100,
          "actionType": "Loop"
        },
        "status": "idle",
        "description": "Detectar cobros sin orden u órdenes sin cobro"
      },
      "type": "action",
