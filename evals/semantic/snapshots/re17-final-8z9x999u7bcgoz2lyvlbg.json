      "id": "ernaN7lRchFz5kyDX_-Ea",
      "data": {
        "type": "trigger",
        "label": "Disparador Diario",
        "config": {
          "triggerType": "Schedule",
          "scheduleCron": "0 8 * * *"
        },
        "status": "idle",
        "description": "Todos los días a las 08:00 AM"
      },
