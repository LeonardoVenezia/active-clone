{
  "name": "Control de Stock Diario (Tiendanube + Mercado Libre)",
  "nodes": [
    {
      "id": "trigger-schedule",
      "type": "trigger",
      "position": {
        "x": 90,
        "y": 260
      },
      "data": {
        "label": "Todos los días 9:00",
        "type": "trigger",
        "config": {
          "triggerType": "Schedule",
          "scheduleCron": "0 9 * * *",
          "timezone": "America/Argentina/Buenos_Aires"
        },
        "status": "idle"
      }
    },
    {
      "id": "list-products",
      "type": "action",
      "position": {
        "x": 460,
        "y": 400
      },
      "data": {
        "label": "Listar Productos Tiendanube",
        "type": "action",
        "config": {
          "limit": "200",
          "actionType": "tiendanube/list-products"
        },
        "status": "idle"
      }
    },
    {
      "id": "list-items",
      "type": "action",
      "position": {
        "x": 460,
        "y": 110
      },
      "data": {
        "label": "Listar Publicaciones Mercado Libre",
        "type": "action",
        "config": {
          "query": "",
          "status": "active",
          "limit": "200",
          "actionType": "mercadolibre/list-items"
        },
        "status": "idle"
      }
    },
    {
      "id": "total-en-falta",
      "type": "action",
      "position": {
        "x": 1570,
        "y": 110
      },
      "data": {
        "label": "Total Productos en Falta",
        "type": "action",
        "config": {
          "input": "{\"tn\": {{@rows-tiendanube:Filas Tiendanube.result}}, \"ml\": {{@rows-mercadolibre:Filas Mercado Libre.result}}}",
          "expression": "$count(tn) + $count(ml)",
          "actionType": "Fórmula"
        },
        "status": "idle"
      }
    },
    {
      "id": "cond-mas-de-3",
      "type": "action",
      "position": {
        "x": 1940,
        "y": 110
      },
      "data": {
        "label": "¿Más de 3 productos en falta?",
        "type": "action",
        "config": {
          "condition": "{{@total-en-falta:Total Productos en Falta.result}} > 3",
          "actionType": "Condition"
        },
        "status": "idle"
      }
    },
    {
      "id": "slack-compras",
      "type": "action",
      "position": {
        "x": 2310,
        "y": 110
      },
      "data": {
        "label": "Avisar a #compras - Slack",
        "type": "action",
        "config": {
          "slackChannel": "#compras",
          "slackMessage": "🚨 Control de stock diario: hay {{@total-en-falta:Total Productos en Falta.result}} productos con stock menor a 5 unidades (Tiendanube y Mercado Libre). El detalle quedó anotado en la planilla de Google Sheets.",
          "actionType": "slack/send-message"
        },
        "status": "idle"
      }
    },
    {
      "id": "loop-tiendanube",
      "type": "action",
      "position": {
        "x": 830,
        "y": 400
      },
      "data": {
        "label": "Filtrar productos Tiendanube stock bajo",
        "type": "action",
        "config": {
          "source": "{{@list-products:Listar Productos Tiendanube.products}}",
          "maxItems": 200,
          "steps": [
            {
              "id": "check-stock",
              "actionType": "Condition",
              "config": {
                "condition": "{{@item:Item.totalStock}} < 5"
              }
            }
          ],
          "actionType": "Loop"
        },
        "status": "idle"
      }
    },
    {
      "id": "loop-mercadolibre",
      "type": "action",
      "position": {
        "x": 830,
        "y": 110
      },
      "data": {
        "label": "Filtrar items Mercado Libre stock bajo",
        "type": "action",
        "config": {
          "source": "{{@list-items:Listar Publicaciones Mercado Libre.items}}",
          "maxItems": 200,
          "steps": [
            {
              "id": "check-stock",
              "actionType": "Condition",
              "config": {
                "condition": "{{@item:Item.availableQuantity}} < 5"
              }
            }
          ],
          "actionType": "Loop"
        },
        "status": "idle"
      }
    },
    {
      "id": "rows-tiendanube",
      "type": "action",
      "position": {
        "x": 1200,
        "y": 400
      },
      "data": {
        "label": "Filas Tiendanube",
        "type": "action",
        "config": {
          "input": "{\"items\": {{@loop-tiendanube:Filtrar productos Tiendanube stock bajo.items}}}",
          "expression": "$map(items, function($x){ [\"Tiendanube\", $x.item.name, $x.item.id, $x.item.totalStock] })",
          "actionType": "Fórmula"
        },
        "status": "idle"
      }
    },
    {
      "id": "rows-mercadolibre",
      "type": "action",
      "position": {
        "x": 1200,
        "y": 110
      },
      "data": {
        "label": "Filas Mercado Libre",
        "type": "action",
        "config": {
          "input": "{\"items\": {{@loop-mercadolibre:Filtrar items Mercado Libre stock bajo.items}}}",
          "expression": "$map(items, function($x){ [\"Mercado Libre\", $x.item.title, $x.item.id, $x.item.availableQuantity] })",
          "actionType": "Fórmula"
        },
        "status": "idle"
      }
    },
    {
      "id": "append-tiendanube",
      "type": "action",
      "position": {
        "x": 1570,
        "y": 410
      },
      "data": {
        "label": "Anotar en Google Sheets (Tiendanube)",
        "type": "action",
        "config": {
          "httpMethod": "POST",
          "endpoint": "https://sheets.googleapis.com/v4/spreadsheets/SPREADSHEET_ID/values/Stock!A:D:append?valueInputOption=USER_ENTERED&insertDataOption=INSERT_ROWS",
          "httpHeaders": "{\"Authorization\": \"Bearer GOOGLE_ACCESS_TOKEN\", \"Content-Type\": \"application/json\"}",
          "httpBody": "{\"values\": {{@rows-tiendanube:Filas Tiendanube.result}}}",
          "actionType": "HTTP Request"
        },
        "status": "idle"
      }
    },
    {
      "id": "append-mercadolibre",
      "type": "action",
      "position": {
        "x": 1570,
        "y": 260
      },
      "data": {
        "label": "Anotar en Google Sheets (Mercado Libre)",
        "type": "action",
        "config": {
          "httpMethod": "POST",
          "endpoint": "https://sheets.googleapis.com/v4/spreadsheets/SPREADSHEET_ID/values/Stock!A:D:append?valueInputOption=USER_ENTERED&insertDataOption=INSERT_ROWS",
          "httpHeaders": "{\"Authorization\": \"Bearer GOOGLE_ACCESS_TOKEN\", \"Content-Type\": \"application/json\"}",
          "httpBody": "{\"values\": {{@rows-mercadolibre:Filas Mercado Libre.result}}}",
          "actionType": "HTTP Request"
        },
        "status": "idle"
      }
    }
  ],
