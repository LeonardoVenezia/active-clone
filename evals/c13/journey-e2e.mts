// Builder half of the unified journey, in-process: the REAL /api/ai/generate route with the prompt the NEW client builds
// (full conversation + the agreed plan from the chat agent), model pinned by the QA selector (ai=g). Free tier only.
import Module from "node:module"; import { createRequire } from "node:module"; import fs from "node:fs"; import path from "node:path"; import { fileURLToPath } from "node:url";
const r = createRequire(import.meta.url); const stub = r.resolve("../../evals/semantic/stubs/server-only.ts");
const o = (Module as any)._resolveFilename; (Module as any)._resolveFilename = function (q: string, ...a: any[]) { return q === "server-only" ? stub : o.call(this, q, ...a); };
process.env.DATABASE_URL ??= "postgres://x:x@localhost:5432/x"; process.env.BETTER_AUTH_SECRET ??= "x".repeat(32); process.env.BETTER_AUTH_URL ??= "http://localhost:3000"; process.env.QA_AI_USER_IDS = "*";
const { auth } = await import("../../lib/auth");
try { (auth.api as any).getSession = async () => ({ user: { id: "eval", isAnonymous: false }, session: { id: "s" } }); } catch { Object.defineProperty(auth.api, "getSession", { value: async () => ({ user: { id: "eval", isAnonymous: false }, session: { id: "s" } }) }); }
await import("../../plugins");
const { POST } = await import("../../app/api/ai/generate/route");
const past = JSON.parse(fs.readFileSync("/tmp/past.json", "utf8")); const plan = fs.readFileSync("/tmp/plan.txt", "utf8");
const wrapper = `\n\nApps with a native plugin (whatsapp, slack, tiendanube, mercadolibre, zipnova, stripe, github, linear, mercadopago) MUST use the plugin action (e.g. whatsapp/send-message, slack/send-message): never generic "Send Message"/"Send Email", never hand-rolled HTTP Request, never the Composio toolkit for those apps. For another app, use Run Composio Action only with the exact toolkit/slug pair from the real catalog below. Set arguments as a JSON string matching that action's input schema. Wire every value an earlier step produces with a template ({{@node-id:Step Label.field.path}}); never ask the user for data that earlier steps produce. If there is no matching listed action, do not guess; ask or explain what is missing.\n\nNo Composio action catalog has been loaded. Do not create a Composio action or invent a tool slug. Use built-in actions where possible; otherwise ask which app/action is needed.`;
const prompt = `Conversation so far:\n${past.slice(-30).map((m: any) => `${m.role}: ${String(m.content).slice(0, 1500)}`).join("\n")}\n\nWhat to do on the canvas now: ${plan}${wrapper}`;
const t0 = Date.now();
const res = await POST(new Request("http://eval.local/api/ai/generate", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ prompt, builder: "tools", ai: "g" }) }));
const raw = await res.text(); const nodes: any[] = []; const edges: any[] = []; const msgs: any[] = [];
for (const line of raw.split("\n")) { const t = line.trim(); if (!t) continue; try { const m = JSON.parse(t); if (m.type === "operation") { const op = m.operation; if (op.op === "addNode") nodes.push(op.node); else if (op.op === "addEdge") edges.push(op.edge); else if (op.op === "removeNode") { const k = nodes.findIndex(n => n.id === op.nodeId); if (k >= 0) nodes.splice(k, 1); } else if (op.op === "updateNode") { const n = nodes.find(x => x.id === op.nodeId); if (n) n.data = { ...n.data, ...(op.updates?.data ?? {}), config: { ...(n.data?.config ?? {}), ...(op.updates?.data?.config ?? {}) } }; } } else msgs.push(m); } catch { msgs.push({ unparsed: t.slice(0, 160) }); } }
const acts = nodes.map(n => n.data?.config?.actionType ?? n.data?.config?.triggerType);
console.log(JSON.stringify({ status: res.status, ms: Date.now() - t0, nodes: nodes.length, edges: edges.length, actions: acts, video: acts.filter((a: string) => /video/.test(String(a))).length, msgs: msgs.map(m => m.type === "trace" ? { trace: m.trace.used, fellBack: m.trace.fellBack, attempts: m.trace.attempts.length } : m.type === "validation" ? { validation: m.errors } : { type: m.type, text: String(m.text ?? m.error ?? "").slice(0, 300) }) }, null, 1));
fs.writeFileSync("/tmp/e2e-snapshot.json", JSON.stringify({ nodes, edges }, null, 2));
