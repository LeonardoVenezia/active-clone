{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/react", "ultracite/next"],
  "files": {
    "includes": [
      "**/*",
      "!components/ui",
      "!components/ai-elements",
      "!lib/utils.ts",
      "!hooks/use-mobile.ts",
      "!plugins"
    ]
  },
  "overrides": [
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      // Deuda preexistente de estilo en archivos legacy que el pack solo toca para registrar pasos.
      // Limpiar estas reglas en un PR dedicado al refactor de cada archivo.
      "includes": [
        "lib/workflow-executor.workflow.ts",
        "lib/workflow-codegen.ts",
        "lib/workflow-codegen-sdk.ts",
        "components/workflow/config/action-grid.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useBlockStatements": "off",
            "useForOf": "off",
            "useTemplate": "off",
            "useCollapsedElseIf": "off",
            "noNonNullAssertion": "off",
            "noNestedTernary": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      // Deuda preexistente de lib/console/reconnect.ts (estilo compacto de una
      // línea, throw Error, any). El pack solo agregó el guard anti re-cifrado;
      // limpiar el estilo completo del archivo en un PR dedicado.
      "includes": ["lib/console/reconnect.ts"],
      "linter": {
        "rules": {
          "style": {
            "useBlockStatements": "off",
            "useThrowNewError": "off",
            "useNumericSeparators": "off",
            "useConsistentBuiltinInstantiation": "off"
          },
          "complexity": {
            "useSimplifiedLogicExpression": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    }
  ]
}
