# Copy to .env.local. Never commit real credentials.
DATABASE_URL=postgresql://localhost:5432/active_clone
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_PROVIDERS=email
# 32-byte encryption key encoded as 64 hex characters
INTEGRATION_ENCRYPTION_KEY=
# Password reset emails: use a verified sender domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Only required when enabling AI generation and Composio connections
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
COMPOSIO_API_KEY=
# Mercado Pago OAuth (platform app with PKCE enabled in the MP developer panel)
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
